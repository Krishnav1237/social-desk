# ===================================
# SOCIALDESK ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values

# -----------------------------------
# App Configuration
# -----------------------------------
APP_ENV=development
APP_NAME=SocialDesk
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# -----------------------------------
# Database
# -----------------------------------
DATABASE_URL=postgresql://socialdesk:socialdesk123@postgres:5432/socialdesk
DB_HOST=postgres
DB_PORT=5432
DB_NAME=socialdesk
DB_USER=socialdesk
DB_PASSWORD=socialdesk123

# For migrations
MIGRATION_DB_USER=socialdesk
MIGRATION_DB_PASSWORD=socialdesk123
MIGRATION_DB_NAME=socialdesk
MIGRATION_DB_HOST=postgres
MIGRATION_DB_PORT=5432

# -----------------------------------
# JWT Authentication
# -----------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------
# OpenAI / LLM Configuration
# -----------------------------------
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Fallback for rate limiting
LLM_RATE_LIMIT_PER_MINUTE=20

# -----------------------------------
# Vector Database (Qdrant)
# -----------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=socialdesk_embeddings

# Alternative: Pinecone
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX=

# -----------------------------------
# Redis
# -----------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------
# Job Queue (BullMQ)
# -----------------------------------
QUEUE_REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=5

# -----------------------------------
# Stripe Payment Processing
# -----------------------------------
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_CONNECT_CLIENT_ID=ca_YOUR_CONNECT_CLIENT_ID_HERE

# Stripe test mode
STRIPE_TEST_MODE=true

# -----------------------------------
# Instagram Integration
# -----------------------------------
IG_APP_ID=your-instagram-app-id
IG_APP_SECRET=your-instagram-app-secret
IG_REDIRECT_URI=http://localhost:4000/api/accounts/callback
IG_API_VERSION=v18.0
IG_GRAPH_API_URL=https://graph.instagram.com

# Instagram Business Account (for testing)
IG_TEST_BUSINESS_ACCOUNT_ID=
IG_TEST_ACCESS_TOKEN=

# -----------------------------------
# TikTok Integration (Future)
# -----------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/accounts/tiktok/callback

# -----------------------------------
# Twitter/X Integration (Future)
# -----------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# -----------------------------------
# Storage (S3-compatible)
# -----------------------------------
S3_BUCKET=socialdesk-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Alternative: DigitalOcean Spaces, MinIO, etc.
STORAGE_PROVIDER=s3
STORAGE_PUBLIC_URL=https://socialdesk-uploads.s3.amazonaws.com

# -----------------------------------
# Email (SendGrid)
# -----------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@socialdesk.com
EMAIL_FROM_NAME=SocialDesk

# Alternative: AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=

# -----------------------------------
# Push Notifications (Future)
# -----------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# -----------------------------------
# Monitoring & Logging
# -----------------------------------
# Sentry for error tracking
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=development

# Log level
LOG_LEVEL=debug

# -----------------------------------
# Rate Limiting
# -----------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Per-user API rate limits
USER_RATE_LIMIT_MAX=1000
USER_RATE_LIMIT_WINDOW=1h

# -----------------------------------
# CORS
# -----------------------------------
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# -----------------------------------
# Session & Cookies
# -----------------------------------
SESSION_SECRET=your-session-secret-change-this
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -----------------------------------
# Feature Flags
# -----------------------------------
FEATURE_MARKETPLACE=true
FEATURE_COLLABORATIONS=true
FEATURE_ANALYTICS=true
FEATURE_REFERRALS=true
FEATURE_GAMIFICATION=true

# -----------------------------------
# AI Features
# -----------------------------------
ENABLE_STYLE_LEARNING=true
ENABLE_VIRAL_SCORE=true
ENABLE_AUTO_HASHTAGS=true
MIN_POSTS_FOR_TRAINING=5

# -----------------------------------
# Content Moderation
# -----------------------------------
ENABLE_CONTENT_MODERATION=true
MODERATION_PROVIDER=openai

# -----------------------------------
# Analytics
# -----------------------------------
ANALYTICS_RETENTION_DAYS=90
ENABLE_ANALYTICS_EXPORT=true

# -----------------------------------
# Webhooks
# -----------------------------------
WEBHOOK_SECRET=your-webhook-secret
ENABLE_WEBHOOKS=true

# -----------------------------------
# Cron Jobs
# -----------------------------------
ENABLE_SCHEDULED_JOBS=true
ANALYTICS_SYNC_INTERVAL=1h
POST_PUBLISH_CHECK_INTERVAL=1m

# -----------------------------------
# Pricing & Credits
# -----------------------------------
FREE_PLAN_CREDITS=100
PRO_PLAN_CREDITS=1000
CREDITS_PER_AI_GENERATION=1
CREDITS_PER_POST=0

# -----------------------------------
# Referral System
# -----------------------------------
REFERRAL_REWARD_CREDITS=50
REFERRAL_CODE_LENGTH=8

# -----------------------------------
# Development
# -----------------------------------
DEBUG=false
MOCK_EXTERNAL_APIS=false
SEED_DATABASE=false

# -----------------------------------
# Testing
# -----------------------------------
TEST_DATABASE_URL=postgresql://socialdesk:socialdesk123@localhost:5432/socialdesk_test
TEST_REDIS_URL=redis://localhost:6379/1
