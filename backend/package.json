{
  "name": "socialdesk-backend",
  "version": "1.0.0",
  "description": "SocialDesk API - AI-powered creator platform backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/jobs/worker.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:create": "node scripts/create-migration.js",
    "migrate:rollback": "node scripts/rollback.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "social-media",
    "ai",
    "creator-economy",
    "fastify"
  ],
  "author": "SocialDesk Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/jwt": "^7.2.3",
    "@fastify/rate-limit": "^9.0.1",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.1",
    "@fastify/cookie": "^9.2.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^6.12.0",
    "fastify": "^4.25.1",
    "pg": "^8.11.3",
    "pg-format": "^1.0.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "openai": "^4.20.1",
    "@qdrant/js-client-rest": "^1.7.0",
    "stripe": "^14.9.0",
    "uuid": "^9.0.1",
    "nanoid": "^3.3.7",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4",
    "@aws-sdk/client-s3": "^3.470.0",
    "@aws-sdk/s3-request-presigner": "^3.470.0",
    "@sendgrid/mail": "^7.7.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "nock": "^13.4.0",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ]
  }
}
